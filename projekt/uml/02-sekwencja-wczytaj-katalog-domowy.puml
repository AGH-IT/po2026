@startuml
title Sekwencja: Wczytaj katalog domowy z pliku (zwykły użytkownik, tylko /home/<login>)

actor "Użytkownik" as U
participant "Interfejs\n(obsługa)" as UI
participant ":SystemPlikow" as SP
participant ":KontrolaDostepu" as KD
participant "domowy :Katalog" as D
participant ":SystemPlikowZapis" as ZP
participant "Files\n(java.nio)" as F
participant "Gson\n(biblioteka)" as G
participant "WezelDane" as WD

U -> UI : wczytaj katalog domowy, wybór pliku w oknie dialogowym
activate UI
UI -> SP : wczytajKatalogDomowy(plik)
activate SP
SP -> SP : wymagajZalogowanego()
SP -> SP : znajdzKatalogDomowy(zalogowany)

alt brak katalogu /home/<login>
  SP --> UI : BladOperacjiException("brak katalogu domowego")
  UI --> U : błąd
else katalog domowy istnieje
  SP -> KD : wymagaj(zalogowany, domowy, ZAPIS)
  activate KD
  note right of KD : «include» Sprawdź prawa dostępu
  alt brak prawa ZAPIS do katalogu domowego
    KD --> SP : BrakUprawnienException
    deactivate KD
    SP --> UI : BrakUprawnienException
    UI --> U : "Brak uprawnień"
  else uprawnienia są
    KD --> SP : (dostęp przyznany)
    deactivate KD
    SP -> ZP : wczytajKatalog(zalogowany, plik)
    activate ZP
    ZP -> F : readString(plik)
    activate F
    alt błąd odczytu (brak pliku, IOException)
      F --> ZP : IOException
      ZP --> SP : BladOperacjiException("nie udało się wczytać", przyczyna)
      SP --> UI : BladOperacjiException
      UI --> U : "Nie udało się wczytać katalogu"
    else plik odczytany
      F --> ZP : json
      deactivate F
      ZP -> G : fromJson(json, WezelDane.class)
      activate G
      G --> ZP : katalogDane
      deactivate G
      ZP -> WD : doWezlaZWlascicielem(zalogowany)
      activate WD
      note right of WD
        Rekurencyjnie tworzy węzły z nazwami, treścią i prawami
        z pliku. Właścicielem **każdego** węzła zostaje zalogowany
        użytkownik, a wlascicielLogin z pliku jest pomijany.
        Ręcznie zmieniony plik nie podrzuci węzłów innego konta.
      end note
      WD --> ZP : nowyKatalog
      deactivate WD
      ZP --> SP : nowyKatalog
      deactivate ZP

      loop dla każdego starego dziecka (kopia listy getDzieci())
        SP -> D : usunDziecko(dziecko)
      end
      loop dla każdego dziecka nowyKatalog (kopia listy getDzieci())
        SP -> D : dodajDziecko(dziecko)
      end
      SP -> SP : biezacyKatalog = domowy
      note right of SP
        Jak przy wczytaniu całej struktury: nowe poddrzewo
        jest gotowe, zanim zastąpi zawartość katalogu domowego.
        Sam katalog /home/<login> (nazwa, właściciel, prawa) zostaje.
      end note
      SP --> UI : (ok)
      UI --> U : "Wczytano katalog domowy"
    end
  end
end
deactivate SP
deactivate UI

@enduml
