@startuml
left to right direction
skinparam packageStyle rectangle

actor "Operator Osiedla" as Operator
actor "Open-Meteo API" as OpenMeteo <<System Zewnętrzny>>

rectangle "Symulator Elektrowni Wirtualnej (VPP)" {
    usecase "UC1: Wybór dnia symulacji\n(historyczny lub na żywo)" as UC1
    usecase "UC2: Uruchomienie symulacji doby\ni obliczenie bilansu energii" as UC2
    usecase "UC3: Wybór strategii sterowania\n(Regułowa / Cenowa)" as UC3
    usecase "UC4: Ręczne wymuszenie trybu magazynu\n(Ładuj / Trzymaj / Automat)" as UC4
    usecase "UC5: Symulacja zdarzeń awaryjnych\n(Awaria wiatraka / Wyłączenie PV / Limit eksportu)" as UC5
    usecase "UC6: Analiza wykresów, kart KPI\ni dziennika zdarzeń" as UC6
    usecase "UC7: Wizualizacja przepływów energii\nna makiecie 3D osiedla" as UC7
    usecase "UC8: Porównanie dwóch strategii\ndla tego samego dnia" as UC8
    usecase "UC9: Eksport wyników symulacji do CSV" as UC9
    usecase "UC10: Pobranie danych pogodowych\n(z obsługą lokalnego cache)" as UC10
}

Operator --> UC1
Operator --> UC2
Operator --> UC3
Operator --> UC4
Operator --> UC5
Operator --> UC6
Operator --> UC7
Operator --> UC8
Operator --> UC9

UC2 ..> UC10 : <<include>>
UC2 ..> UC3 : <<include>>
UC8 ..> UC2 : <<include>>
UC10 --> OpenMeteo
@enduml